// Kontrol System 2 - v0.5.9.5
// https://github.com/tbma2014us/ksp2_ssto_scripts/

use { AutopilotMode, Vessel, VesselSituation, PartCategory } from ksp::vessel
use { CONSOLE } from ksp::console
use { current_time, sleep, yield, wait_until } from ksp::game
use { current_warp_rate, max_warp_index, set_warp_index } from ksp::game::warp
use { trigger_staging } from std::staging
use { clamp, floor, abs, max, min } from core::math
use { format } from core::str
use { estimate_burn_time, exec_next_node } from std::vac
use { circularize_orbit } from std::maneuvers
use { pid_loop } from ksp::control
use { remove_all_nodes } from std::utils
use { MAIN_LOG } from ksp::debug

sync fn timestamp() -> string = {
    let t = current_time() % 21600.0
    let hh = floor(t / 3600.0)
    let mm = floor((t % 3600.0) / 60.0)
    let ss = floor(t % 60.0)
    format("[{0,2:00}:{1,2:00}:{2,2:00}]", [hh, mm, ss])
}

sync fn con_log(message: string) -> Unit = {
    CONSOLE.print_line($"{timestamp()} {message}")
}

fn norm_angle_deg(angle: float) -> float = {
    let a = angle
    while (a > 180.0) { a = a - 360.0 }
    while (a < -180.0) { a = a + 360.0 }
    return a
}

fn roll_to_level(vessel: Vessel) -> float = {
    let roll = norm_angle_deg(vessel.pitch_yaw_roll.z)
    return norm_angle_deg(-roll)
}

pub sync fn max_temp_fraction(vessel: Vessel) -> float =
    vessel.parts
        .map(fn(p) -> p.temperature / max(p.max_temperature, 1.0))
        .reduce(0.0, fn(acc, f) -> max(acc, f))

fn current_engines(vessel: Vessel) -> ksp::vessel::ModuleEngine[] =
    vessel.staging.parts_in_stage(vessel.staging.current)
        .filter(fn(p) -> p.is_engine)
        .map(fn(p) -> p.engine_module.value)

fn retract_all_gear(vessel: Vessel) -> Unit = {
    const gear = vessel.parts
        .filter(fn(p) -> p.part_category == PartCategory.Ground && p.deployable.defined && p.deployable.value.extended)
    if (gear.length > 0) {
        con_log($"Retracting gear ({gear.length} part(s))")
        gear.map(fn(p) -> p.deployable.value.set_extended(false))
    }
}

fn ascent_actions_logic(vessel: Vessel, open_cycle_cutoff_speed: float, open_cycle: Cell<bool>) -> Unit = {
    if (vessel.altitude_scenery > 50.0) {
        retract_all_gear(vessel)
        if (vessel.static_pressure_kpa < 2.0 || vessel.horizontal_surface_speed >= open_cycle_cutoff_speed) {
            if (open_cycle.value) {
                const to_closed = current_engines(vessel).filter(fn(e) -> e.engine_modes.exists(fn(m) -> m.name == "Closed Cycle"))
                if (to_closed.length > 0) { con_log("Engines -> closed cycle") }
                to_closed.map(fn(e) -> e.change_mode("Closed Cycle"))
                open_cycle.value = false
            }
            const to_close = vessel.air_intakes.filter(fn(i) -> i.toogle_intake)
            if (to_close.length > 0) { con_log("Air intakes closed") }
            to_close.map(fn(i) -> i.toogle_intake = false)
        }
    }
    yield()
}

fn pitch_control_logic(vessel: Vessel, liftoff_speed: float, liftoff_pitch: float, subsonic_pitch: float, transonic_pitch: float, supersonic_pitch: float,
open_cycle_cutoff_speed: float, closed_cycle_pitch: float) -> float = {
    if(vessel.altitude_scenery < 50.0 && vessel.horizontal_surface_speed < liftoff_speed) {
        return 0.0
    }
    if (vessel.altitude_scenery >= 50.0 && vessel.altitude_sealevel < 1000.0) {
        return liftoff_pitch
    }
    if(vessel.altitude_sealevel >= 1000.0) {
        if (vessel.horizontal_surface_speed > open_cycle_cutoff_speed) {
            return closed_cycle_pitch
        }
        const mach = vessel.mach_number
        if (mach < 0.95) { return subsonic_pitch }
        if (mach < 1.5)  { return transonic_pitch }
        return supersonic_pitch
    }
    liftoff_pitch
}

fn rocket_pitch(vessel: Vessel, liftoff_speed: float, liftoff_pitch: float) -> float = {
    if (vessel.altitude_scenery < 50.0 && vessel.horizontal_surface_speed < liftoff_speed) {
        return 0.0
    }
    const alt = vessel.altitude_sealevel
    if (alt < 200.0) { return liftoff_pitch }
    clamp(50.0 - alt / 800.0, 3.0, 50.0)
}

pub fn main_flight(vessel: Vessel, target_apoapsis: int = 100000, liftoff_speed: float = 50.0, liftoff_pitch: float = 5.0) -> Result<Unit> = {
    const subsonic_pitch = 5.0
    const transonic_pitch = 15.0
    const supersonic_pitch = 9.0
    const open_cycle_cutoff_speed = 1500.0
    const closed_cycle_pitch = 15.0
    const temp_max = 0.85
    const q_max = 50.0
    
    if(vessel.situation == VesselSituation.PreLaunch || vessel.situation == VesselSituation.Landed) {
        CONSOLE.clear()
        con_log("=== Start: ssto_launch ===")
        con_log("=== Brakes: on ===")
        vessel.actions.light = true
        vessel.actions.brakes = true
        sleep(1.0)
    } else if(vessel.situation == VesselSituation.Flying) {
        con_log("=== Restart: ssto_launch ===")
    } else return Ok({})
    
    const starts_air_breathing = current_engines(vessel).exists(fn(e) -> e.current_engine_mode.name == "Air Breathing")
    let open_cycle: Cell<bool> = Cell(starts_air_breathing)

    const prof_air = vessel.engines.exists(fn(e) -> e.current_engine_mode.engine_type.to_string() == "Turbine" || e.current_engine_mode.engine_type.to_string() == "ScramJet")
    const prof_nuc = vessel.engines.exists(fn(e) -> e.current_engine_mode.engine_type.to_string() == "Nuclear")
    const prof_thr_sl = vessel.engines.reduce(0.0, fn(a, e) -> a + e.max_thrust_output_atm)
    const prof_thr_vac = vessel.engines.reduce(0.0, fn(a, e) -> a + e.max_thrust_output_vac)
    const prof_twr_sl = prof_thr_sl / (vessel.mass * 9.81)
    const prof_twr_vac = prof_thr_vac / (vessel.mass * 9.81)
    const jet_nerv = prof_air && prof_nuc
    const is_rocket = !prof_air
    const prof_kind = if (jet_nerv) { "JET/NERV" } else { if (is_rocket) { "ROCKET (thermal throttle)" } else { "air-breather" } }
    const twr_sl_s = prof_twr_sl.to_fixed(2)
    const twr_vac_s = prof_twr_vac.to_fixed(2)
    con_log("PROFILE " + prof_kind + "  TWRsl=" + twr_sl_s + " TWRvac=" + twr_vac_s)

    vessel.autopilot.enabled = true
    vessel.autopilot.mode = AutopilotMode.Autopilot
    
    if(vessel.situation != VesselSituation.Flying) {
        sleep(1.0)
        con_log("Launch: Trigger initial stage")
        vessel.staging.next()
        con_log("=== Brakes: off ===")
        vessel.actions.brakes = false
    }

    const console_row = CONSOLE.cursor_row
    CONSOLE.move_cursor(console_row + 1, 0)

    vessel.set_throttle(1.0)

    let current_pitch: float = vessel.pitch_yaw_roll.x
    let pitchPID = pid_loop(0.1, 0.01, 0.05, -1.0, 1.0)
    let rollPID = pid_loop(0.04, 0.0, 0.012, -1.0, 1.0)
    rollPID.setpoint = 0.0
    MAIN_LOG.truncate()
    let last_log = current_time() - 1.0
    const pitch_cap = if (is_rocket) { 50.0 } else { 25.0 }
    const pitch_rate = if (is_rocket) { 0.3 } else { 0.1 }

    while(vessel.orbit.apoapsis.value < target_apoapsis) {
        let target_pitch = if (is_rocket) {
            rocket_pitch(vessel, liftoff_speed, liftoff_pitch)
        } else {
            pitch_control_logic(vessel, liftoff_speed, liftoff_pitch,
            subsonic_pitch, transonic_pitch, supersonic_pitch, open_cycle_cutoff_speed, closed_cycle_pitch)
        }
        pitchPID.setpoint = target_pitch

        let now = current_time()
        let pitch_adjustment = pitchPID.update(now, current_pitch)
        current_pitch += pitch_adjustment * pitch_rate

        current_pitch = clamp(current_pitch, -5.0, pitch_cap)
        CONSOLE.print_at(console_row, 0, $"Target pitch: {target_pitch,5:N3} Pitch: {current_pitch,5:N3} Speed: {vessel.horizontal_surface_speed,5:N1}")

        vessel.autopilot.target_orientation = vessel.heading_direction(90, current_pitch, 0).vector
        let roll_err = roll_to_level(vessel)
        let roll_input = clamp(rollPID.update(now, roll_err), -1.0, 1.0)
        vessel.override_input_roll(roll_input)
        ascent_actions_logic(vessel, open_cycle_cutoff_speed, open_cycle)

        let thermal = max_temp_fraction(vessel)
        let throttle = 1.0
        if (is_rocket) {
            const t_thermal = clamp(1.0 - (thermal - temp_max) * 8.0, 0.30, 1.0)
            const t_q = clamp(1.0 - (vessel.dynamic_pressure_kpa - q_max) * 0.03, 0.60, 1.0)
            throttle = min(t_thermal, t_q)
            vessel.set_throttle(throttle)
        }

        if(trigger_staging(vessel)) {
            con_log("Next stage triggered")
        }

        if (now - last_log >= 0.25) {
            last_log = now
            let mode = if (open_cycle.value) { "AIR" } else { "ROCKET" }
            let apo  = vessel.orbit.apoapsis.value
            MAIN_LOG.log($"time={now:F1},alt={vessel.altitude_sealevel:F0},hspd={vessel.horizontal_surface_speed:F1},vspd={vessel.vertical_speed:F1},pitch={current_pitch:F2},tgtpitch={target_pitch:F2},roll={roll_err:F2},mach={vessel.mach_number:F2},q={vessel.dynamic_pressure_kpa:F2},throttle={throttle:F2},thermal={thermal:F3},spress={vessel.static_pressure_kpa:F3},mass={vessel.mass:F2},apo={apo:F0},stage={vessel.staging.current},mode={mode}")
        }

        sleep(0.03)
    }
    
    vessel.set_throttle(0)
    vessel.override_input_roll(0.0)
    con_log("Coasting to space")

    vessel.autopilot.mode = AutopilotMode.Prograde
    sleep(15)
    wait_until(fn() ->  abs(vessel.angular_velocity.x) < 0.01)

    con_log("Warping to orientation")
    set_warp_index(max_warp_index())
    wait_until(fn() -> vessel.altitude_sealevel > vessel.main_body.atmosphere_depth * 0.9)

    set_warp_index(0)
    wait_until(fn() -> current_warp_rate() == 1.0)
    sleep(1)

    con_log("=== Done: ssto_launch ===")

    const (delta_v, UT) = circularize_orbit(vessel.orbit)?
    // @ts-ignore
    let (burn_time, half_burn_time) = estimate_burn_time(vessel, delta_v.magnitude, 0.5, 1.0)
    vessel.maneuver.add_burn_vector(UT - half_burn_time, delta_v)?
    vessel.autopilot.mode = AutopilotMode.Maneuver
    exec_next_node(vessel)?
    remove_all_nodes(vessel)

    con_log($"Orbiting {vessel.main_body.name}")
}
