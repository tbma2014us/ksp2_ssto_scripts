// Kontrol System 2 - v0.5.9.5
// https://github.com/tbma2014us/ksp2_ssto_scripts/

use { Vessel, PartCategory, Part } from ksp::vessel
use { CONSOLE, RED, BLUE, YELLOW, GREEN, CYAN } from ksp::console
use { DEBUG } from ksp::debug
use { sleep } from ksp::game
use { vec3, Vec3, GlobalVector, GlobalPosition } from ksp::math
 
fn calculate_center_of_mass(vessel: Vessel) -> Vec3 = {
    let total_mass = 0.0
    let weighted_position : Vec3 = vec3(0,0,0)
    for (part in vessel.parts) {
        total_mass += part.total_mass
        weighted_position += part.global_position.to_local(vessel.body_frame) * part.total_mass
    }
    weighted_position / total_mass
}

fn calculate_center_of_lift(vessel: Vessel) -> Vec3 = {
    let total_lift = 0.0
    let weighted_position = vec3(0, 0, 0)

    for(part in vessel.parts) {
        if (part.control_surface.defined) {
            let lift_magnitude = part.control_surface.value.lift_force.magnitude
            if (lift_magnitude > 0) {
                total_lift += lift_magnitude
                weighted_position += part.control_surface.value.global_lift_position.to_local(vessel.body_frame) * lift_magnitude
            }
        }
        if (part.drag.defined) {
            let body_lift_magnitude = part.drag.value.body_lift_force.magnitude
            if (body_lift_magnitude > 0) {
                total_lift += body_lift_magnitude
                weighted_position += part.drag.value.global_body_lift_position.to_local(vessel.body_frame) * body_lift_magnitude
            }
        }
    }

    if(total_lift > 0) {
        let center_of_lift = weighted_position / total_lift
        return center_of_lift
    } else {
        return vessel.CoM
    }
}

pub fn main_flight(vessel: Vessel) -> Result<Unit, string> = {
    const center_of_mass = calculate_center_of_mass(vessel)
    const center_of_lift = calculate_center_of_lift(vessel)

    let mass_vector = DEBUG.add_vector(fn() -> center_of_mass.to_position(vessel.body_frame), fn() ->  vessel.global_up * -50, RED, "center of mass", 1)
    let lift_vector = DEBUG.add_vector(fn() -> center_of_lift.to_position(vessel.body_frame), fn() -> vessel.global_up * 50, CYAN, "center of lift", 1)
    sleep(30)
}