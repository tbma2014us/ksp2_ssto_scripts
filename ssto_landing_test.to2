// Kontrol System 2 - v0.5.9.5
// https://github.com/tbma2014us/ksp2_ssto_scripts/

// Design coonsiderations for reentry: 
// * Keep the plane slightly nose-heavy to avoid flying tail-forward
// * Add plenty of reaction wheels to keep the craft responsive in thin atmosphere
// * Bring enough batteries to keep the control wheels powered
// * Airbrakes are extremely useful for bleeding speed and helping with thermal management
// * Make sure the plane has enough pitch authority
// * A good reentry plane should naturally stabilize in level flight

use { AutopilotMode, Vessel, VesselSituation } from ksp::vessel
use { CONSOLE, GREEN } from ksp::console
use { CONSOLE_WINDOW, open_window, Align, screen_size } from ksp::ui
use { current_time, sleep, wait_until, yield } from ksp::game
use { set_warp_index, current_warp_rate, max_warp_index } from ksp::game::warp
use { clamp, floor, abs, max, min, sqrt, cos, sin, asin, atan2, cos_deg, sin_deg, DEG_TO_RAD, RAD_TO_DEG, PI } from core::math
use { format } from core::str
use { exec_next_node } from std::vac
use { pid_loop } from ksp::control
use { Orbit, Body, GeoCoordinates } from ksp::orbit
use { Vec3, vec3, vec2 } from ksp::math
use { DEBUG, MAIN_LOG } from ksp::debug
use { land_deorbit_delta_v, land_time_to_longitude } from std::land::lib
use { angle_to_360, remove_all_nodes } from std::utils
use { fuel_rebalance } from ssto_rebalance

const DEBUGGING : bool = false

sync fn timestamp() -> string = {
    let t = current_time() % 21600.0
    let hh = floor(t / 3600.0)
    let mm = floor((t % 3600.0) / 60.0)
    let ss = floor(t % 60.0)
    format("[{0,2:00}:{1,2:00}:{2,2:00}]", [hh, mm, ss])
}

sync fn con_log(message: string) -> Unit = {
    CONSOLE.print_line($"{timestamp()} {message}")
}

pub fn limit_thrust(vessel: Vessel, perc: float) -> Unit = {
    for (e in vessel.engines) {
        e.thrust_limiter = perc / 100
    }
}

pub fn wait_for_orientation(vessel: Vessel) -> Unit = {
    while (abs(vessel.angular_velocity.x) < 0.01 &&
           abs(vessel.angular_velocity.y) < 0.01 &&
           abs(vessel.angular_velocity.z) < 0.01) {
        sleep(0.1)
    }
}

pub struct Runway(runway_name : string, runway_body : Body) {
    name: string = runway_name
    body: Body = runway_body
}

impl Runway {
    fn get_latitude(self) -> float = {
        let lat = 0.0
        if (self.name == "09L") { lat = -0.62766870196000 }
        if (self.name == "27R") { lat = -0.62746120210750 }
        if (self.name == "09R") { lat = -0.65073148191674 }
        if (self.name == "27L") { lat = -0.65050994217456 }
        lat
    }

    fn get_longitude(self) -> float = {
        let long = 0.0
        if (self.name == "09L") { long = -75.298537244905 }
        if (self.name == "27R") { long = -74.680323506261 }
        if (self.name == "09R") { long = -75.296690328232 }
        if (self.name == "27L") { long = -74.678579196137 }
        long
    }

    fn get_altitude(self) -> float = {
        self.body.terrain_height(self.get_latitude(), self.get_longitude())
    }

    fn geo_coord(self) -> GeoCoordinates = {
        self.body.geo_coordinates(self.get_latitude(), self.get_longitude())
    }

    fn get_altitude_position(self) -> Vec3 = {
        self.geo_coord().altitude_position(self.get_altitude())
    }

    fn print_coord(self) -> string = {
        self.get_altitude_position().to_string()
    }
}

pub struct LandingStrip(
    strip_name    : string,
    strip_display : string,
    strip_lat     : float,
    strip_lon     : float,
    strip_heading : float,
    strip_body    : Body
) {
    name    : string = strip_name
    display : string = strip_display
    lat     : float  = strip_lat
    lon     : float  = strip_lon
    heading : float  = strip_heading   // compass heading to fly on final approach
    body    : Body   = strip_body
}

impl LandingStrip {
    fn geo_coord(self) -> GeoCoordinates =
        self.body.geo_coordinates(self.lat, self.lon)

    fn altitude(self) -> float =
        self.body.terrain_height(self.lat, self.lon)

    fn uprange_heading(self) -> float =
        (self.heading + 180.0) % 360.0
}

// Offset a lat/lon by distance_m in bearing_deg direction (spherical earth)
fn offset_geo(body: Body, lat: float, lon: float, bearing_deg: float, distance_m: float) -> GeoCoordinates = {
    let R   = body.radius
    let d   = distance_m / R
    let lat_r = lat * DEG_TO_RAD
    let lon_r = lon * DEG_TO_RAD
    let brng  = bearing_deg * DEG_TO_RAD
    let lat2  = asin(sin(lat_r) * cos(d) + cos(lat_r) * sin(d) * cos(brng))
    let lon2  = lon_r + atan2(sin(brng) * sin(d) * cos(lat_r), cos(d) - sin(lat_r) * sin(lat2))
    body.geo_coordinates(lat2 * RAD_TO_DEG, lon2 * RAD_TO_DEG)
}

sync fn lerp(start_val: float, end_val: float, t: float) -> float = {
    start_val + t * (end_val - start_val)
}

fn normalize_longitude(lon: float) -> float = {
    let new_lon = lon
    if (lon > 180.0) { new_lon -= 360.0 }
    else if (lon < -180.0) { new_lon += 360.0 }
    new_lon
}

fn bearing_to_target(craft: Vessel, target: GeoCoordinates) -> float = {
    let craft_geo = craft.geo_coordinates
    let lat1 = craft_geo.latitude * DEG_TO_RAD
    let lon1 = craft_geo.longitude * DEG_TO_RAD
    let lat2 = target.latitude * DEG_TO_RAD
    let lon2 = target.longitude * DEG_TO_RAD
    let dlon = lon2 - lon1
    let y = sin(dlon) * cos(lat2)
    let x = cos(lat1) * sin(lat2) - sin(lat1) * cos(lat2) * cos(dlon)
    atan2(y, x)
}

fn surface_distance(vessel: Vessel, target: GeoCoordinates) -> float = {
    let r = vessel.main_body.radius
    let vessel_gc = vessel.geo_coordinates
    let dlat = (target.latitude - vessel_gc.latitude) * DEG_TO_RAD
    let dlon = (target.longitude - vessel_gc.longitude) * DEG_TO_RAD
    let lat1 = vessel_gc.latitude * DEG_TO_RAD
    let lat2 = target.latitude * DEG_TO_RAD
    let a = sin(dlat / 2.0) ** 2 + cos(lat1) * cos(lat2) * sin(dlon / 2.0) ** 2
    let c = 2.0 * atan2(sqrt(a), sqrt(1.0 - a))
    r * c
}

// Signed angle from a to b around axis (degrees)
fn signed_angle(a: Vec3, b: Vec3, axis: Vec3) -> float = {
    atan2(axis.cross(a).dot(b), a.dot(b)) * RAD_TO_DEG
}

fn geo_to_vec3(tgt: GeoCoordinates, alt: float, radius: float) -> Vec3 = {
    let lat_r = tgt.latitude * DEG_TO_RAD
    let lon_r = tgt.longitude * DEG_TO_RAD
    let r = radius + alt
    vec3(r * cos(lat_r) * cos(lon_r), r * cos(lat_r) * sin(lon_r), r * sin(lat_r))
}

fn direction_to_target(vessel: Vessel, target: GeoCoordinates) -> Vec3 = {
    let body = vessel.main_body
    let radius = body.radius
    let v_gc = vessel.geo_coordinates
    let v_pos = geo_to_vec3(v_gc, vessel.altitude_terrain, radius)
    let tgt_alt = body.terrain_height(target.latitude, target.longitude)
    let t_pos = geo_to_vec3(target, tgt_alt, radius)
    (t_pos - v_pos).normalized
}

fn project_to_plane(v: Vec3, normal: Vec3) -> Vec3 = {
    v - (v.dot(normal)) * normal
}

pub fn total_drag(vessel: Vessel) -> float = {
    vessel.parts
        .filter(fn(p) -> p.is_lifting_surface || p.is_drag)
        .map(fn(p) -> p.drag.value.drag_force.magnitude)
        .reduce(0.0, fn(acc, f) -> acc + f)
}

pub fn total_lift(vessel: Vessel) -> float = {
    let lift_total = vessel.parts
        .filter(fn(p) -> p.is_lifting_surface)
        .map(fn(p) -> p.lifting_surface.value.lift_force.magnitude)
        .reduce(0.0, fn(acc, f) -> acc + f)
    let body_lift_total = vessel.parts
        .filter(fn(p) -> p.is_drag)
        .map(fn(p) -> p.drag.value.body_lift_force.magnitude)
        .reduce(0.0, fn(acc, f) -> acc + f)
    lift_total + body_lift_total
}

sync fn max_temp_fraction(vessel: Vessel) -> float =
    vessel.parts
        .map(fn(p) -> p.temperature / max(p.max_temperature, 1.0))
        .reduce(0.0, fn(acc, f) -> max(acc, f))

fn log_aero_state(vessel: Vessel) -> Unit = {
    let t = current_time()
    let altitude = vessel.altitude_sealevel
    let speed = vessel.surface_velocity.magnitude
    let v_speed = vessel.vertical_speed
    let drag = total_drag(vessel)
    let lift = total_lift(vessel)
    let mass = vessel.mass
    MAIN_LOG.log($"time={t},alt={altitude},speed={speed},vspeed={v_speed},drag={drag},lift={lift},mass={mass}")
}

fn norm_angle_deg(angle: float) -> float = {
    let a = angle
    while (a > 180.0) {
        a = a - 360.0
    }
    while (a < -180.0) {
        a = a + 360.0
    }
    return a
}

fn roll_to_level(vessel: Vessel) -> float = {
    // Current roll, normalized to [-180, 180]
    let roll = norm_angle_deg(vessel.pitch_yaw_roll.z)

    // Desired roll is 0, so error is -roll
    return norm_angle_deg(-roll)
}

// 2D ballistic trajectory predictor (vertical plane along great-circle track).
// Integrates gravity + drag from current state until landing_alt is reached.
// Returns predicted horizontal range (m); compare to surface_distance(vessel, target)
// to determine overshoot/undershoot for pitch correction.
// cd_a_over_m: effective CdA/mass (m^2/kg), calibrated live from observed drag.
sync fn predict_range(
    v_horiz     : float,
    v_vert      : float,
    alt_asl     : float,
    body        : Body,
    cd_a_over_m : float,
    cl_a_over_m : float,
    landing_alt : float
) -> float = {
    let vr    = v_horiz
    let va    = v_vert
    let h     = alt_asl
    let R     = body.radius
    let GM    = body.grav_parameter
    let dt    = 4.0
    let range = 0.0
    let i     = 0
    while (i < 4000) {
        let radius = R + h
        let g      = GM / (radius * radius)
        let v_tot  = sqrt(vr * vr + va * va)
        let rho    = body.atmosphere_density(h)
        let drag_k = if (v_tot > 1.0) { 0.5 * rho * v_tot * cd_a_over_m } else { 0.0 }
        let lift_k = if (v_tot > 1.0) { 0.5 * rho * v_tot * cl_a_over_m } else { 0.0 }
        // lift is perpendicular to velocity: direction (-va, vr)/v_tot in the vertical plane
        let dvr = -(drag_k * vr) - (lift_k * va) + vr * va / radius
        let dva = -g - (drag_k * va) + (lift_k * vr) + vr * vr / radius
        vr    += dvr * dt
        va    += dva * dt
        range += vr * dt
        h     += va * dt
        if (h <= landing_alt + 10.0) { break }
        i += 1
    }
    range
}

// Plane-change + deorbit for a spaceplane.
// Skips plane change if orbit inclination is within 1° of landing site latitude.
pub fn ssto_prepare_deorbit(vessel: Vessel, landing_site: GeoCoordinates) -> Result<Unit> = {
    CONSOLE.print_line("=== ssto_prepare_deorbit ===")

    const deorbit_radius = vessel.main_body.radius - 3000
    const r1 = vessel.orbit.semi_major_axis
    const r2 = deorbit_radius
    const pt = 0.5 * ((r1 + r2) / (2 * r2)) ** 1.5
    const sp = sqrt((4 * PI * PI * r2 * r2 * r2) / vessel.main_body.grav_parameter)
    const deorbit_travel_time = pt * sp / 2
    const phi = deorbit_travel_time / vessel.main_body.rotation_period * 360.0
    const inc_travel_time = vessel.orbit.period / 2
    const phi_inc_maneuver = inc_travel_time / vessel.main_body.rotation_period * 360.0

    let deorbit_longitude = angle_to_360(landing_site.longitude - 90)
    let plane_change_longitude = angle_to_360(landing_site.longitude - 270)

    if (vessel.orbit.inclination < -90 || vessel.orbit.inclination > 90) {
        deorbit_longitude = angle_to_360(landing_site.longitude + 90)
        plane_change_longitude = angle_to_360(landing_site.longitude + 270)
    }

    const inc_diff = abs(vessel.orbit.inclination - landing_site.latitude)
    if (inc_diff > 1.5) {
        const vel = vessel.orbit.orbital_velocity(land_time_to_longitude(vessel, plane_change_longitude))
        const inc = landing_site.latitude
        const n_dv = vel.magnitude * sin_deg(inc)
        const p_dv = vel.magnitude * (cos_deg(inc) - 1)
        if (n_dv * n_dv + p_dv * p_dv > 0.1) {
            CONSOLE.print_line($"Plane change: {inc_diff:N2}° off — {n_dv:N1} m/s anti-normal, {p_dv:N1} m/s prograde.")
            vessel.maneuver.add(current_time() + land_time_to_longitude(vessel, plane_change_longitude + phi_inc_maneuver), 0, -n_dv, p_dv)?
            exec_next_node(vessel)?
        }
    } else {
        CONSOLE.print_line($"Plane change skipped — {inc_diff:N2}° within 1.5° tolerance.")
    }

    const deorbit_dv = land_deorbit_delta_v(vessel, deorbit_radius - vessel.main_body.radius)
    CONSOLE.print_line($"Deorbit burn: {deorbit_dv:N1} m/s retrograde.")
    vessel.maneuver.add(current_time() + land_time_to_longitude(vessel, deorbit_longitude + phi), 0, 0, deorbit_dv)?
    exec_next_node(vessel)?

    Ok({})
}

pub fn deorbit(vessel: Vessel, landing_site: GeoCoordinates) -> Result<Unit> = {
    fuel_rebalance(vessel, 65.0, 0.3, true)
    CONSOLE.print_line("=== deorbit ===")

    if (DEBUGGING) {
        DEBUG.clear_markers()
        DEBUG.add_ground_marker(landing_site, GREEN, 0)
    }

    if (vessel.situation == VesselSituation.Orbiting) {
        ssto_prepare_deorbit(vessel, landing_site)?
        sleep(1.0)
    }

    Ok({})
}

fn select_landing_strip(vessel: Vessel) -> LandingStrip = {
    const body = vessel.main_body
    const selected: Cell<int> = Cell(-1)

    const sz = screen_size()
    const w = open_window("<b>SELECT LANDING STRIP</b>",
        sz.x * 0.5 - 175.0, sz.y * 0.5 + 160.0, 350.0, 240.0)
    const panel = w.add_vertical_panel(6.0, Align.Stretch)
    panel.add_label("Choose destination:", Align.Center)
    panel.add_spacer(4.0)

    const b0 = panel.add_button("KSC  Runway 09L  (main)",     Align.Stretch, 3.0)
    const b1 = panel.add_button("KSC  Runway 09R  (parallel)", Align.Stretch, 3.0)
    const b2 = panel.add_button("Island Airfield",              Align.Stretch, 3.0)

    while (selected.value < 0 && !w.is_closed) {
        b0.on_click(fn() -> { selected.value = 0 })
        b1.on_click(fn() -> { selected.value = 1 })
        b2.on_click(fn() -> { selected.value = 2 })
        yield()
    }
    w.close()

    if      (selected.value == 1) { LandingStrip("KSC-09R", "KSC Runway 09R", -0.636804891522271, -75.0210938472135, 90.0, body) }
    else if (selected.value == 2) { LandingStrip("Island",  "Island Airfield", -1.540833,          -71.909722,        90.0, body) }
    else                          { LandingStrip("KSC-09L", "KSC Runway 09L", -0.62757487479866,  -75.0211055718462, 90.0, body) }
}

pub fn main_flight(vessel: Vessel, overshoot: float = 580.0) -> Result<Unit> = {
    CONSOLE.clear()
    CONSOLE_WINDOW.open()
    CONSOLE_WINDOW.size = vec2(700, 400)

    const strip = select_landing_strip(vessel)
    con_log($"Destination: {strip.display}")

    const strip_geo = strip.geo_coord()
    const strip_alt = strip.altitude()

    let mode = if (vessel.situation == VesselSituation.Orbiting) { 1 } else { 2 }

    if (mode == 1) {
        if (vessel.orbit.eccentricity > 0.02) {
            con_log($"Orbit eccentric (e={vessel.orbit.eccentricity:N3}) — circularizing.")
            const orb     = vessel.orbit
            const mu      = vessel.main_body.grav_parameter
            const r_apo   = orb.apoapsis.value + vessel.main_body.radius
            const dv_circ = sqrt(mu / r_apo) - sqrt(mu * (2.0 / r_apo - 1.0 / orb.semi_major_axis))
            const t_apo   = orb.next_apoapsis_time(Some(current_time())).value
            remove_all_nodes(vessel)
            vessel.maneuver.add(t_apo, 0.0, 0.0, dv_circ)?
            vessel.autopilot.mode = AutopilotMode.Maneuver
            exec_next_node(vessel)?
            con_log("Orbit circularized.")
        }

        const aim_geo = offset_geo(vessel.main_body, strip.lat, strip.lon, strip.uprange_heading(), overshoot * 1000.0)
        CONSOLE.print_line($"Strip: {strip.display}  hdg={strip.heading:N0}°")
        CONSOLE.print_line($"Deorbit aim: {overshoot:N0} km uprange on {strip.uprange_heading():N0}°")
        yield()

        deorbit(vessel, aim_geo)?

        vessel.autopilot.enabled = true
        vessel.autopilot.mode = AutopilotMode.Autopilot
        con_log("Waiting for atmosphere.")
        set_warp_index(max_warp_index())

        while (vessel.altitude_sealevel >= vessel.main_body.atmosphere_depth) {
            if (vessel.horizontal_surface_speed > 10.0) {
                vessel.autopilot.target_orientation = vessel.surface_velocity.normalized
            } else {
                vessel.autopilot.target_orientation = (vessel.global_position - vessel.main_body.global_position).to_local(vessel.celestial_frame).normalized
            }
            yield()
        }

        set_warp_index(0)
        wait_until(fn() -> current_warp_rate() == 1.0)
        mode = 2
        yield()
    }

    while (mode == 2) {
        con_log("Mode 2: Entering atmosphere.")

        set_warp_index(0)
        wait_until(fn() -> current_warp_rate() == 1.0)

        // Stabilise on prograde, then acquire strip heading with roll levelling.
        vessel.autopilot.enabled = true
        vessel.autopilot.mode = AutopilotMode.Prograde
        sleep(15.0)

        let dir2 = bearing_to_target(vessel, strip_geo)
        vessel.autopilot.mode = AutopilotMode.Autopilot
        vessel.autopilot.target_orientation = vessel.heading_direction(dir2 * RAD_TO_DEG, 40.0, 0.0).vector
        let acq_timeout = current_time() + 30.0
        while (abs(vessel.pitch_yaw_roll.z) > 1.0 && current_time() < acq_timeout) {
            sleep(0.05)
        }
        vessel.override_input_roll(0.0)

        let dir = bearing_to_target(vessel, strip_geo)
        vessel.autopilot.target_orientation = vessel.heading_direction(dir * RAD_TO_DEG, 40.0, 0.0).vector

        con_log("Atmospheric flight.")
        vessel.actions.brakes = false

        MAIN_LOG.truncate()
        let last_log_time = current_time()

        const console_row = CONSOLE.cursor_row
        CONSOLE.move_cursor(console_row + 1, 0)

        let hypersonic_min = 1800.0
        let thermal_frac = 0.0
        let cd_a_over_m = 0.001
        let cl_a_over_m = 0.0002
        let predicted_range = 0.0
        let pred_valid = false
        let eng_thr4 = 0.0
        let vspd_pid = pid_loop(0.05, 0.002, 0.05, -25.0, 25.0)
        let roll_pid = pid_loop(0.05, 0.001, 0.05, -1.0, 1.0)

        mode = 3

        // ---- MODE 3: Hypersonic reentry (>1800 m/s) ----
        // High nose-up attitude to bleed speed. Altitude profile: 10 km AGL at 50 km out.
        while (mode == 3) {
            let speed   = vessel.horizontal_surface_speed
            let dist    = surface_distance(vessel, strip_geo)
            let alt_agl = vessel.altitude_sealevel - strip_alt

            dir = bearing_to_target(vessel, strip_geo)

            // Glide floor ensures desired altitude drops toward the runway as dist shrinks.
            // At 50 km: max(7500, 12000) = 12 km; at 20 km: max(3000, ..) = 3 km; at 10 km: ~1.5 km.
            let desired_alt = max(dist * 0.15, 12000.0 + (dist - 50000.0) * 0.27)
            let target_pitch = 3.0

            if (speed >= hypersonic_min) {
                let t = clamp((speed - hypersonic_min) / (2500.0 - hypersonic_min), 0.0, 1.0)
                let base_pitch = lerp(35.0, 50.0, t)
                let alt_err = alt_agl - desired_alt
                let pitch_correction = clamp(-alt_err / 5000.0 * 8.0, -8.0, 8.0)
                target_pitch = clamp(base_pitch + pitch_correction, 25.0, 60.0)
            }

            // Thermal protection: RAISE pitch when hot so the belly faces the airstream.
            if (thermal_frac > 0.78) {
                target_pitch = max(target_pitch, 45.0)
            } else if (thermal_frac > 0.65) {
                target_pitch = max(target_pitch, 35.0)
            }

            vessel.actions.brakes = thermal_frac >= 0.85 || (pred_valid && predicted_range > dist)

            if (speed < hypersonic_min) {
                vessel.actions.brakes = false
                if (pred_valid) {
                    const range_error_km = (predicted_range - dist) / 1000.0
                    const suggested_overshoot = overshoot + range_error_km
                    if (range_error_km > 5.0) {
                        con_log($"*** PILOT: You will overshoot by ~{range_error_km:N0} km. Next run use: main_flight(vessel, overshoot={suggested_overshoot:N0}) ***")
                    } else if (range_error_km < -5.0) {
                        con_log($"*** PILOT: You will undershoot by ~{-range_error_km:N0} km. Next run use: main_flight(vessel, overshoot={suggested_overshoot:N0}) ***")
                    } else {
                        con_log($"*** PILOT: Range looks good ({range_error_km:N1} km). overshoot={overshoot:N0} is working well. ***")
                    }
                }
                mode = 4
            }

            let hdg_err3     = norm_angle_deg(dir * RAD_TO_DEG - vessel.pitch_yaw_roll.y)
            let desired_bank3 = clamp(hdg_err3 * 0.4, -15.0, 15.0)
            let roll3         = vessel.pitch_yaw_roll.z
            if (abs(norm_angle_deg(roll3 - desired_bank3)) > 90.0) {
                target_pitch = min(target_pitch, 5.0)
            }
            roll_pid.setpoint = desired_bank3
            vessel.autopilot.target_orientation = vessel.heading_direction(dir * RAD_TO_DEG, target_pitch, desired_bank3).vector
            vessel.override_input_roll(roll_pid.update(current_time(), roll3))

            CONSOLE.print_at(
                console_row, 0,
                $"[3] Dist:{dist/1000,5:N1}km Alt:{alt_agl/1000,4:N1}km Spd:{speed,5:N0} Ptch:{target_pitch,4:N1} Thm:{thermal_frac,4:N2} Bank:{desired_bank3,5:N1} Pred:{predicted_range/1000,5:N1}km  "
            )

            let now = current_time()
            if (now - last_log_time >= 1.0) {
                log_aero_state(vessel)
                last_log_time = now
                thermal_frac = max_temp_fraction(vessel)

                // Rolling average for effective drag and lift coefficients
                const rho3 = vessel.main_body.atmosphere_density(vessel.altitude_sealevel)
                const dyn_q3 = 0.5 * rho3 * speed * speed
                if (dyn_q3 > 200.0) {
                    const mass3 = vessel.mass
                    const drag3 = total_drag(vessel)
                    const cdam3 = drag3 / (dyn_q3 * mass3)
                    if (cdam3 > 0.0001 && cdam3 < 0.05) {
                        cd_a_over_m = cd_a_over_m * 0.92 + cdam3 * 0.08
                    }
                    const lift3 = total_lift(vessel)
                    const clam3 = lift3 / (dyn_q3 * mass3)
                    if (clam3 > 0.0 && clam3 < 0.05) {
                        cl_a_over_m = cl_a_over_m * 0.92 + clam3 * 0.08
                    }
                }

                // Trajectory prediction
                const p3_v_horiz = speed
                const p3_v_vert = vessel.vertical_speed
                const p3_alt = vessel.altitude_sealevel
                const p3_body = vessel.main_body
                const p3_cdam = cd_a_over_m
                const p3_clam = cl_a_over_m
                const p3_ralt = strip_alt
                predicted_range = predict_range(p3_v_horiz, p3_v_vert, p3_alt, p3_body, p3_cdam, p3_clam, p3_ralt)
                pred_valid = true
                const g3_ap = vessel.pitch_yaw_roll.x
                MAIN_LOG.log($"g,mode=3,dist={dist:N0},alt={alt_agl:N0},spd={speed:N0},tpitch={target_pitch:N2},apitch={g3_ap:N2},pred={predicted_range:N0},cdam={cd_a_over_m:N6},clam={cl_a_over_m:N6}")
            }

            sleep(0.01)
        }

        // ---- MODE 4: Energy bleed glide (transition → final approach setup) ----
        while (mode == 4) {
            let speed   = vessel.horizontal_surface_speed
            let dist    = surface_distance(vessel, strip_geo)
            let alt_agl = vessel.altitude_sealevel - strip_alt

            let vspeed4 = vessel.vertical_speed
            let target_vspd = lerp(-50.0, -10.0, clamp((thermal_frac - 0.65) / 0.20, 0.0, 1.0))
            vspd_pid.setpoint = target_vspd

            let t4 = current_time()
            let slope_deg = -atan2(max(alt_agl, 0.0), max(dist, 1000.0)) * RAD_TO_DEG
            let aoa       = lerp(3.0, 12.0, clamp((speed - 200.0) / 800.0, 0.0, 1.0))
            let pid_corr  = vspd_pid.update(t4, vspeed4)
            let target_pitch = clamp(slope_deg + aoa + pid_corr, 2.0, 45.0)

            let can_thrust4 = vessel.static_pressure_kpa > 2.0 && thermal_frac < 0.72
            let thr_upper = 1600.0 + 150.0 * clamp(eng_thr4 * 100.0, 0.0, 1.0)
            if (can_thrust4 && speed < thr_upper) {
                eng_thr4 = clamp((1600.0 - speed) * 0.001, 0.0, 0.8)
            } else {
                eng_thr4 = 0.0
            }
            vessel.actions.brakes = thermal_frac >= 0.90 || (pred_valid && predicted_range > dist)
            vessel.set_throttle(eng_thr4)

            dir = bearing_to_target(vessel, strip_geo)

            // vessel.autopilot.target_orientation = vessel.heading_direction(dir * RAD_TO_DEG, target_pitch, 0.0).vector
            // let roll4     = vessel.pitch_yaw_roll.z
            // let roll_abs4 = abs(roll4)
            let hdg_err4      = norm_angle_deg(dir * RAD_TO_DEG - vessel.pitch_yaw_roll.y)
            let desired_bank4 = clamp(hdg_err4 * 0.4, -15.0, 15.0)
            let roll4         = vessel.pitch_yaw_roll.z
            roll_pid.setpoint = desired_bank4
            vessel.autopilot.target_orientation = vessel.heading_direction(dir * RAD_TO_DEG, target_pitch, desired_bank4).vector
            vessel.override_input_roll(roll_pid.update(current_time(), roll4))

            CONSOLE.print_at(
                console_row, 0,
                $"[4] Dist:{dist/1000,5:N1}km Alt:{alt_agl/1000,4:N1}km Spd:{speed,5:N0} VSpd:{vspeed4,4:N0}/{target_vspd,4:N0} Ptch:{target_pitch,4:N1} Thr:{eng_thr4,3:N1} Thm:{thermal_frac,4:N2} Bank:{desired_bank4,5:N1}  "
            )

            let now = current_time()
            if (now - last_log_time >= 1.0) {
                log_aero_state(vessel)
                last_log_time = now
                thermal_frac = max_temp_fraction(vessel)

                // Engine management: open intakes and switch to air-breathing when
                // atmosphere is thick enough (static pressure > 2 kPa ≈ below 25 km).
                // Maintain speed above 1700 m/s where trim AoA is positive.
                if (vessel.static_pressure_kpa > 2.0 && speed < 1700.0) {
                    for (intake_ in vessel.air_intakes) {
                        intake_.toogle_intake = true
                    }
                    for (eng4 in vessel.engines) {
                        const has_ab4 = eng4.engine_modes.exists(fn(m) -> m.name == "Air Breathing")
                        if (has_ab4) {
                            eng4.change_mode("Air Breathing")
                        }
                    }
                }

                // Rolling average for effective drag and lift coefficients
                const rho4 = vessel.main_body.atmosphere_density(vessel.altitude_sealevel)
                const dyn_q4 = 0.5 * rho4 * speed * speed
                if (dyn_q4 > 200.0) {
                    const mass4 = vessel.mass
                    const drag4 = total_drag(vessel)
                    const cdam4 = drag4 / (dyn_q4 * mass4)
                    if (cdam4 > 0.0001 && cdam4 < 0.05) {
                        cd_a_over_m = cd_a_over_m * 0.92 + cdam4 * 0.08
                    }
                    const lift4 = total_lift(vessel)
                    const clam4 = lift4 / (dyn_q4 * mass4)
                    if (clam4 > 0.0 && clam4 < 0.05) {
                        cl_a_over_m = cl_a_over_m * 0.92 + clam4 * 0.08
                    }
                }

                // Trajectory prediction
                const p4_v_horiz = speed
                const p4_v_vert = vessel.vertical_speed
                const p4_alt = vessel.altitude_sealevel
                const p4_body = vessel.main_body
                const p4_cdam = cd_a_over_m
                const p4_clam = cl_a_over_m
                const p4_ralt = strip_alt
                predicted_range = predict_range(p4_v_horiz, p4_v_vert, p4_alt, p4_body, p4_cdam, p4_clam, p4_ralt)
                pred_valid = true
                const g4_ap = vessel.pitch_yaw_roll.x
                MAIN_LOG.log($"g,mode=4,dist={dist:N0},alt={alt_agl:N0},spd={speed:N0},vspd={vspeed4:N0},tvspd={target_vspd:N0},tpitch={target_pitch:N2},apitch={g4_ap:N2},slope={slope_deg:N2},prcor={pid_corr:N2},thr={eng_thr4:N2},pred={predicted_range:N0}")
            }

            if (dist < 20000.0 && alt_agl < 4000.0) {
                vessel.set_throttle(0.0)
                eng_thr4 = 0.0
                mode = 5
            }

            sleep(0.01)
        }

        // ---- MODE 5: Stable approach (20 km → 10 km) ----
        // No S-turns. Target 200–300 m/s.
        while (mode == 5) {
            let speed   = vessel.horizontal_surface_speed
            let dist    = surface_distance(vessel, strip_geo)
            let alt_agl = vessel.altitude_sealevel - strip_alt

            let target_speed = max(200.0, lerp(200.0, 300.0, clamp((dist - 10000.0) / 10000.0, 0.0, 1.0)))
            let speed_excess = speed - target_speed
            vessel.actions.brakes = speed_excess > 0.0

            let slope_deg    = -atan2(max(alt_agl, 0.0), max(dist, 500.0)) * RAD_TO_DEG
            let aoa          = lerp(2.0, 8.0, clamp((speed - 100.0) / 200.0, 0.0, 1.0))
            let target_pitch = clamp(max(slope_deg, -8.0) + aoa, 2.0, 15.0)

            dir = bearing_to_target(vessel, strip_geo)

            let hdg_err5      = norm_angle_deg(dir * RAD_TO_DEG - vessel.pitch_yaw_roll.y)
            let desired_bank5 = clamp(hdg_err5 * 0.4, -15.0, 15.0)
            let roll5         = vessel.pitch_yaw_roll.z
            roll_pid.setpoint = desired_bank5
            vessel.autopilot.target_orientation = vessel.heading_direction(dir * RAD_TO_DEG, target_pitch, desired_bank5).vector
            vessel.override_input_roll(roll_pid.update(current_time(), roll5))

            CONSOLE.print_at(
                console_row, 0,
                $"[5] Dist:{dist/1000,5:N1}km Alt:{alt_agl/1000,4:N1}km Spd:{speed,5:N0}/{target_speed,4:N0} Ptch:{target_pitch,4:N1} Bank:{desired_bank5,5:N1}  "
            )

            let now = current_time()
            if (now - last_log_time >= 1.0) {
                log_aero_state(vessel)
                last_log_time = now
                const g5_ap = vessel.pitch_yaw_roll.x
                MAIN_LOG.log($"g,mode=5,dist={dist:N0},alt={alt_agl:N0},spd={speed:N0},tspd={target_speed:N0},tpitch={target_pitch:N2},apitch={g5_ap:N2},slope={slope_deg:N2}")
            }

            if (dist < 10000.0) {
                mode = 6
            }

            sleep(0.01)
        }

        // ---- MODE 6: Final approach (10 km → 20 m AGL) ----
        // Fixed heading 090. Gear down at 500 m AGL. Target 120–150 m/s.
        while (mode == 6) {
            let speed   = vessel.horizontal_surface_speed
            let dist    = surface_distance(vessel, strip_geo)
            let alt_agl = vessel.altitude_sealevel - strip_alt

            let target_speed = max(120.0, lerp(120.0, 150.0, clamp(dist / 10000.0, 0.0, 1.0)))
            let speed_excess = speed - target_speed
            vessel.actions.brakes = speed_excess > 0.0

            let slope_deg    = -atan2(max(alt_agl, 0.0), max(dist, 100.0)) * RAD_TO_DEG
            let aoa          = lerp(1.0, 5.0, clamp((speed - 80.0) / 100.0, 0.0, 1.0))
            let target_pitch = clamp(max(slope_deg, -6.0) + aoa, 2.0, 10.0)

            let roll6 = vessel.pitch_yaw_roll.z
            roll_pid.setpoint = 0.0
            vessel.autopilot.target_orientation = vessel.heading_direction(strip.heading, target_pitch, 0.0).vector
            vessel.override_input_roll(roll_pid.update(current_time(), roll6))

            if (alt_agl < 500.0) {
                vessel.actions.gear = true
            }

            CONSOLE.print_at(
                console_row, 0,
                $"[6] Dist:{dist/1000,5:N1}km Alt:{alt_agl,6:N0}m Spd:{speed,5:N0}/{target_speed,4:N0} Ptch:{target_pitch,4:N1} Roll:{roll6,5:N1}  "
            )

            let now = current_time()
            if (now - last_log_time >= 1.0) {
                log_aero_state(vessel)
                last_log_time = now
                const g6_ap = vessel.pitch_yaw_roll.x
                MAIN_LOG.log($"g,mode=6,dist={dist:N0},alt={alt_agl:N0},spd={speed:N0},tspd={target_speed:N0},tpitch={target_pitch:N2},apitch={g6_ap:N2},slope={slope_deg:N2}")
            }

            if (alt_agl < 20.0) {
                mode = 7
            }

            sleep(0.01)
        }

        // ---- MODE 7: Flare (20 m → touchdown) ----
        while (mode == 7) {
            let speed   = vessel.horizontal_surface_speed
            let alt_agl = vessel.altitude_sealevel - strip_alt

            let target_pitch = lerp(0.0, 3.0, clamp(alt_agl / 20.0, 0.0, 1.0))

            vessel.actions.brakes = true
            vessel.actions.gear = true
            let roll7 = vessel.pitch_yaw_roll.z
            roll_pid.setpoint = 0.0
            vessel.autopilot.target_orientation = vessel.heading_direction(strip.heading, target_pitch, 0.0).vector
            vessel.override_input_roll(roll_pid.update(current_time(), roll7))

            CONSOLE.print_at(
                console_row, 0,
                $"[7] Alt:{alt_agl,6:N0}m Spd:{speed,5:N0} Ptch:{target_pitch,4:N1} Roll:{roll7,5:N1}  "
            )

            let now = current_time()
            if (now - last_log_time >= 1.0) {
                log_aero_state(vessel)
                last_log_time = now
            }

            if (vessel.situation == VesselSituation.Landed || speed < 5.0) {
                mode = 8
            }

            sleep(0.01)
        }

        // ---- MODE 8: Rollout ----
        vessel.override_input_roll(0.0)
        vessel.actions.brakes = true
        con_log("Landed. Rolling out...")
        wait_until(fn() -> vessel.horizontal_surface_speed < 2.0)
        vessel.actions.brakes = false
        con_log("Stopped.")
    }

    Ok({})
}
